#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exe_suffix=
case "$(uname -s)" in
    MINGW*|MSYS*)
        script_dir=$(cygpath -am "$script_dir")
        exe_suffix=.exe
        ;;
esac
binary="$script_dir/target/release/rust-test$exe_suffix"
if [ ! -x "$binary" ]; then
    cargo build --release --offline --manifest-path "$script_dir/Cargo.toml" --target-dir "$script_dir/target" >&2
fi
exec "$binary" "$@"
